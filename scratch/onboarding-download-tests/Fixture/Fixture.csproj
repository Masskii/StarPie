<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>TestFixturePlugin</AssemblyName>
    <RootNamespace>TestFixturePlugin</RootNamespace>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="StarPiePluginId" Value="starpie.plugin.keypadlayer" />
    <AssemblyMetadata Include="StarPiePluginName" Value="Keypad Layer" />
    <AssemblyMetadata Include="StarPiePluginLicense" Value="MIT" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\plugin\sdk\StarPie.Plugin.Abstractions\StarPie.Plugin.Abstractions.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
