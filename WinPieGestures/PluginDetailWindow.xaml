<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WinPieGestures.PluginDetailWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="插件详情" Icon="app_icon.ico" Height="620" Width="620" MinHeight="440" MinWidth="500" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" Background="{DynamicResource WindowBackgroundBrush}" FontFamily="Segoe UI, Microsoft YaHei UI, Arial">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="PrimaryBtn" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="🔌" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0" />
        <StackPanel>
          <TextBlock Name="NameText" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Name="StatusText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Name="DescriptionHeaderText" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Name="DescriptionText" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,14" />
        <TextBlock Name="FeaturesHeaderText" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
        <ItemsControl Name="FeaturesItemsControl" Margin="0,6,0,14">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="0,0,0,6">
                <StackPanel>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="•" FontSize="13" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,6,0" /><TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Text="{Binding Category}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,1,0,0" /></StackPanel>
                  <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="17,3,0,0" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Name="NoFeaturesText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" Visibility="Collapsed" />
        <TextBlock Name="CapabilitiesHeaderText" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Name="CapabilitiesText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,14" />
        <TextBlock Name="MetadataHeaderText" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <TextBlock Name="AuthorLabelText" Grid.Row="0" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,5" /><TextBlock Name="AuthorValueText" Grid.Row="0" Grid.Column="1" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,5" />
          <TextBlock Name="LicenseLabelText" Grid.Row="1" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,5" /><TextBlock Name="LicenseValueText" Grid.Row="1" Grid.Column="1" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,5" />
          <TextBlock Name="VersionLabelText" Grid.Row="2" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,5" /><TextBlock Name="VersionValueText" Grid.Row="2" Grid.Column="1" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5" />
          <TextBlock Name="SourceLabelText" Grid.Row="3" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,5" /><TextBlock Name="SourceValueText" Grid.Row="3" Grid.Column="1" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5" />
          <TextBlock Name="PluginIdLabelText" Grid.Row="4" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,5" /><TextBlock Name="PluginIdValueText" Grid.Row="4" Grid.Column="1" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,5" />
          <TextBlock Name="TargetFrameworkLabelText" Grid.Row="5" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,5" /><TextBlock Name="TargetFrameworkValueText" Grid.Row="5" Grid.Column="1" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5" />
          <TextBlock Name="DependenciesLabelText" Grid.Row="6" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,5" /><TextBlock Name="DependenciesValueText" Grid.Row="6" Grid.Column="1" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,5" />
          <TextBlock Name="InstallPathLabelText" Grid.Row="7" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,5" /><TextBlock Name="InstallPathValueText" Grid.Row="7" Grid.Column="1" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,5" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
    <Button Name="CloseButton" Grid.Row="2" Content="关闭" Style="{StaticResource PrimaryBtn}" Height="30" Padding="16,0" HorizontalAlignment="Right" Margin="0,12,0,0" IsCancel="True" Click="CloseButton_Click" />
  </Grid>
</Window>
